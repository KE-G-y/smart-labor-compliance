# Docker Compose host ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
MYSQL_HOST_PORT=3306
MILVUS_HOST_PORT=19530
MILVUS_WEBUI_HOST_PORT=9091
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Runtime
APP_ENV=production
API_PREFIX=/api
AUTO_SEED=true

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=infini_rag_flow
DB_NAME=employment

# Admin and auth
JWT_SECRET_KEY=change-this-before-production
JWT_EXPIRE_MINUTES=480
PASSWORD_MIN_LENGTH=8
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456
DEFAULT_TENANT_CODE=demo-sx

# HTTP and upload limits
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
UPLOAD_DIR=storage/uploads
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# LangChain and OpenAI-compatible model
LANGCHAIN_BASE_URL=
LANGCHAIN_API_KEY=
LANGCHAIN_MODEL=
LANGCHAIN_EMBEDDING_MODEL=bge-m3
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_TIMEOUT_SECONDS=45

# LangSmith tracing
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-labor-compliance

# Milvus vector store
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=slc_compliance_docs
MILVUS_BASE_COLLECTION=slc_compliance_docs
MILVUS_PLATFORM=linux/amd64
VECTOR_SEARCH_MODE=hybrid
VECTOR_TOP_K=4
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=50
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL_PATH=models/bge-m3
LOCAL_RERANKER_ENABLED=false
LOCAL_RERANKER_MODEL_PATH=models/bge-reranker-large
LOCAL_FALLBACK_BERT_MODEL_PATH=models/bert-base-chinese
VECTOR_BUILD_TENANT_CODE=demo-sx
VECTOR_BUILD_CATEGORIES=
VECTOR_BUILD_VERSION=
VECTOR_BUILD_ACTIVATE=--activate

# MinIO used by Milvus
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional Dify fallback
DIFY_BASE_URL=http://host.docker.internal/v1
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=30

# Optional RAGFlow links
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_WEB_URL=http://host.docker.internal:8880
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=10
