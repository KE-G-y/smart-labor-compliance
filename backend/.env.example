# Local backend runtime. Copy to backend/.env for non-Docker local development.

APP_ENV=development
API_PREFIX=/api
AUTO_SEED=true

# Local MySQL. The one-click script can start this through docker compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=infini_rag_flow
DB_NAME=employment

# Admin and auth. Change before sharing or production use.
JWT_SECRET_KEY=local-dev-change-before-production
JWT_EXPIRE_MINUTES=480
PASSWORD_MIN_LENGTH=8
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456
DEFAULT_TENANT_CODE=demo-sx

# Local frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# HTTP and upload limits.
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
UPLOAD_DIR=storage/uploads
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# LangChain and OpenAI-compatible model provider.
# LANGCHAIN_API_KEY must be created in your model provider console.
LANGCHAIN_BASE_URL=
LANGCHAIN_API_KEY=
LANGCHAIN_MODEL=
LANGCHAIN_EMBEDDING_MODEL=bge-m3
LANGCHAIN_TEMPERATURE=0.2
LANGCHAIN_TIMEOUT_SECONDS=45

# Local Milvus. The one-click script can start Milvus through docker compose.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=slc_compliance_docs
MILVUS_BASE_COLLECTION=slc_compliance_docs
VECTOR_SEARCH_MODE=hybrid
VECTOR_TOP_K=4
VECTOR_CHUNK_SIZE=500
VECTOR_CHUNK_OVERLAP=50
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL_PATH=models/bge-m3
LOCAL_RERANKER_ENABLED=true
LOCAL_RERANKER_MODEL_PATH=models/bge-reranker-large
LOCAL_FALLBACK_BERT_MODEL_PATH=models/bert-base-chinese

# Optional Dify fallback.
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=60

# Optional RAGFlow links.
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_WEB_URL=http://127.0.0.1:8880
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=10
